{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "maskExpand": {
      "description": "是否屏蔽,默认是",
      "type": "boolean",
      "default": true
    },
    "dotX1": {
      "description": "点 1 X",
      "type": "number"
    },
    "dotY1": {
      "description": "点 1 Y",
      "type": "number"
    },
    "dotX2": {
      "description": "点 2 X",
      "type": "number"
    },
    "dotY2": {
      "description": "点 2 Y",
      "type": "number"
    },
    "expandWidth": {
      "description": "展开宽度",
      "type": [
        "number",
        "null"
      ]
    },
    "expandHeight": {
      "description": "展开高度",
      "type": [
        "number",
        "null"
      ]
    },
    "strokeColor": {
      "description": "颜色",
      "type": [
        "string",
        "null"
      ]
    },
    "strokeStyle": {
      "description": "样式, null 为默认",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SOLID",
        "SHORT_DASH",
        "DOT",
        "DOT_DASH",
        null
      ],
      "enumDescriptions": {
        "SOLID": "实线",
        "SHORT_DASH": "短划线",
        "DOT": "点线",
        "DOT_DASH": "点划线"
      },
      "default": null
    },
    "fillColor": {
      "description": "填充颜色：\"\" 不填充，填充自动闭合起始点和结束点",
      "type": [
        "string",
        "null"
      ]
    },
    "strokeWidth": {
      "description": "宽度",
      "type": [
        "number",
        "null"
      ]
    },
    "fillStyle": {
      "description": "填充样式, null 为默认",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NONE",
        "SOLID",
        "GRID",
        "HORIZONTAL_LINE",
        "VERTICAL_LINE",
        "RHOMBIC",
        "LEFT_SLASH_LINE",
        "RIGHT_SLASH_LINE",
        null
      ],
      "enumDescriptions": {
        "NONE": "无填充",
        "SOLID": "实心填充",
        "GRID": "网格",
        "HORIZONTAL_LINE": "横线",
        "VERTICAL_LINE": "竖线",
        "RHOMBIC": "菱形网格",
        "LEFT_SLASH_LINE": "左斜线",
        "RIGHT_SLASH_LINE": "右斜线"
      },
      "default": null
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "maskExpand",
    "dotX1",
    "dotY1",
    "dotX2",
    "dotY2",
    "expandWidth",
    "expandHeight",
    "strokeColor",
    "strokeStyle",
    "fillColor",
    "strokeWidth",
    "fillStyle"
  ],
  "description": "屏蔽区域"
}