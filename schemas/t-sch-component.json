{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "x": {
      "description": "位置 X",
      "type": "number"
    },
    "y": {
      "description": "位置 Y",
      "type": "number"
    },
    "partId": {
      "description": "子库编号：默认 \"\"",
      "type": "string"
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "rotation": {
      "description": "旋转角度（角度制）：绕 位置 旋转",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "isMirror": {
      "description": "是否镜像",
      "type": "boolean"
    },
    "attrs": {
      "description": "",
      "type": "object"
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "x",
    "y",
    "partId",
    "rotation",
    "isMirror",
    "attrs"
  ],
  "description": "元件"
}