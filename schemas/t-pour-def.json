{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "覆铜类型定义",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pourType": {
          "description": "实心填充",
          "type": "string",
          "enum": [
            "SOLID"
          ],
          "enumDescriptions": {
            "SOLID": "实心填充"
          }
        },
        "fineness": {
          "description": "最小覆铜细度",
          "type": "number"
        }
      },
      "required": [
        "pourType",
        "fineness"
      ],
      "description": "实心填充"
    },
    {
      "type": "object",
      "properties": {
        "pourType": {
          "description": "线填充",
          "type": "string",
          "enum": [
            "GRID_LINE",
            "HORIZONTAL_LINE",
            "VERTICAL_LINE"
          ],
          "enumDescriptions": {
            "GRID_LINE": "网格线填充",
            "HORIZONTAL_LINE": "水平线填充",
            "VERTICAL_LINE": "垂直线填充"
          }
        },
        "angle": {
          "description": "填充线的角度（**不是**可自由旋转的角度）：盘上只可能是 `0` 或 `45`\r\n（`45` = 45° 网格填充），写别的值会被判非法。",
          "type": "number"
        },
        "strokeWidth": {
          "description": "线宽（mil）",
          "type": "number"
        },
        "strokeSpacing": {
          "description": "线距（mil）",
          "type": "number"
        }
      },
      "required": [
        "pourType",
        "angle",
        "strokeWidth",
        "strokeSpacing"
      ],
      "description": "线填充"
    }
  ]
}