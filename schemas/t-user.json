{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "uuid": {
      "description": "用户 uuid：**账号级标识**（同一用户跨工程、跨文档稳定），由服务端下发。\r\n文档头里以 `user.uuid` 出现；`EDIT_HEAD.uuid` 也是它（见 `TEditHead.uuid`）。",
      "type": "string"
    },
    "nickname": {
      "description": "用户昵称",
      "type": "string"
    },
    "username": {
      "description": "用户名称",
      "type": "string"
    },
    "avatar": {
      "description": "用户头像",
      "type": "string"
    }
  },
  "required": [
    "uuid",
    "nickname",
    "username"
  ],
  "description": "用户信息"
}