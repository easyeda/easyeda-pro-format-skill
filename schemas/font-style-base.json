{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "color": {
      "description": "字体颜色：`\"#RRGGBB\"` 十六进制色值；null 表示采用主题默认色",
      "type": [
        "string",
        "null"
      ]
    },
    "fillColor": {
      "description": "字体背景色：`\"#RRGGBB\"` 十六进制色值；null 表示无背景 / 采用主题默认\r\n\r\n ⚠️ **语义随宿主而变**：只有 **TABLE 单元格**上的它才是真正的背景色；\r\n 在 TEXT / ATTR 上它与 `color` 同源（同一个颜色字段），且**解码端根本不读它**\r\n （只读 `color`），不要把它当独立字段依赖。",
      "type": [
        "string",
        "null"
      ]
    },
    "fontFamily": {
      "description": "字体名称",
      "type": [
        "string",
        "null"
      ]
    },
    "fontSize": {
      "description": "字体大小，与坐标等单位相同",
      "type": [
        "number",
        "null"
      ]
    },
    "strikeout": {
      "description": "是否加删除线",
      "type": [
        "boolean",
        "null"
      ]
    },
    "underline": {
      "description": "是否加下划线",
      "type": [
        "boolean",
        "null"
      ]
    },
    "italic": {
      "description": "是否斜体",
      "type": [
        "boolean",
        "null"
      ]
    },
    "fontWeight": {
      "description": "是否加粗",
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "color",
    "fillColor",
    "fontFamily",
    "fontSize",
    "strikeout",
    "underline",
    "italic",
    "fontWeight"
  ],
  "description": "字体样式基础字段"
}