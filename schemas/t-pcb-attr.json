{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "layerId": {
      "description": "层编号",
      "type": "number"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "parentId": {
      "description": "父级编号，没有则为空",
      "type": "string"
    },
    "x": {
      "description": "位置 X：未显示过的属性位置固定为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "y": {
      "description": "位置 Y：未显示过的属性位置固定为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "key": {
      "description": "Key",
      "type": "string"
    },
    "value": {
      "description": "Value",
      "type": "string"
    },
    "keyVisible": {
      "description": "是否显示 Key",
      "type": "boolean"
    },
    "valueVisible": {
      "description": "是否显示 Value",
      "type": "boolean"
    },
    "fontFamily": {
      "description": "字体名称",
      "type": [
        "string",
        "null"
      ]
    },
    "fontSize": {
      "description": "字号",
      "type": [
        "number",
        "null"
      ]
    },
    "strokeWidth": {
      "description": "粗细",
      "type": "number"
    },
    "bold": {
      "description": "是否加粗",
      "type": "boolean"
    },
    "italic": {
      "description": "是否斜体",
      "type": [
        "boolean",
        "null"
      ]
    },
    "origin": {
      "description": "对齐模式",
      "type": "string",
      "enum": [
        "LEFT_BOTTOM",
        "CENTER_BOTTOM",
        "RIGHT_BOTTOM",
        "LEFT_MIDDLE",
        "CENTER_MIDDLE",
        "RIGHT_MIDDLE",
        "LEFT_TOP",
        "CENTER_TOP",
        "RIGHT_TOP"
      ],
      "enumDescriptions": {
        "LEFT_BOTTOM": "左底",
        "CENTER_BOTTOM": "中底",
        "RIGHT_BOTTOM": "右底",
        "LEFT_MIDDLE": "左中",
        "CENTER_MIDDLE": "中中",
        "RIGHT_MIDDLE": "右中",
        "LEFT_TOP": "左顶",
        "CENTER_TOP": "中顶",
        "RIGHT_TOP": "右顶"
      }
    },
    "angle": {
      "description": "旋转角度（角度制）",
      "type": "number"
    },
    "reverse": {
      "description": "是否反相扩展",
      "type": "boolean"
    },
    "expansion": {
      "description": "反相扩展尺寸：反相扩展区域的尺寸，支持负数",
      "type": "number"
    },
    "mirror": {
      "description": "是否镜像，一般来说，当一个文字出现在底层，这里也需要相应调整成 1",
      "type": "boolean"
    },
    "specialColor": {
      "description": "特殊颜色",
      "type": "string",
      "pattern": "^$|^#[0-9A-Fa-f]{6}$"
    }
  },
  "required": [
    "groupId",
    "layerId",
    "locked",
    "zIndex",
    "parentId",
    "x",
    "y",
    "key",
    "value",
    "keyVisible",
    "valueVisible",
    "fontFamily",
    "fontSize",
    "strokeWidth",
    "bold",
    "italic",
    "origin",
    "angle",
    "reverse",
    "expansion",
    "mirror"
  ],
  "description": "PCB 属性"
}