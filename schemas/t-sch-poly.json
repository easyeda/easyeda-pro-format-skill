{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partId": {
      "description": "部件编号；符号页专属，表示归属于某部件下, 非符号忽略该字段",
      "type": "string"
    },
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "points": {
      "description": "点集坐标",
      "type": "array"
    },
    "closed": {
      "description": "是否自动闭合：如果自动闭合，则结束点会自动连上起始点",
      "type": "boolean"
    },
    "startShape": {
      "description": "起点形状",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NONE",
        "ARROW",
        "SOLID_ARROW",
        "TAIL",
        "SOLID_TAIL",
        "CIRCLE",
        "SQUARE",
        "RHOMBUS"
      ],
      "enumDescriptions": {
        "NONE": "无",
        "ARROW": "箭头",
        "SOLID_ARROW": "实心箭头",
        "TAIL": "尾巴",
        "SOLID_TAIL": "燕尾箭头",
        "CIRCLE": "圆形",
        "SQUARE": "方形",
        "RHOMBUS": "菱形"
      }
    },
    "endShape": {
      "description": "终点形状",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NONE",
        "ARROW",
        "SOLID_ARROW",
        "TAIL",
        "SOLID_TAIL",
        "CIRCLE",
        "SQUARE",
        "RHOMBUS"
      ],
      "enumDescriptions": {
        "NONE": "无",
        "ARROW": "箭头",
        "SOLID_ARROW": "实心箭头",
        "TAIL": "尾巴",
        "SOLID_TAIL": "燕尾箭头",
        "CIRCLE": "圆形",
        "SQUARE": "方形",
        "RHOMBUS": "菱形"
      }
    },
    "strokeColor": {
      "description": "颜色",
      "type": [
        "string",
        "null"
      ]
    },
    "strokeStyle": {
      "description": "样式, null 为默认",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SOLID",
        "SHORT_DASH",
        "DOT",
        "DOT_DASH"
      ],
      "enumDescriptions": {
        "SOLID": "实线",
        "SHORT_DASH": "短划线",
        "DOT": "点线",
        "DOT_DASH": "点划线"
      }
    },
    "fillColor": {
      "description": "填充颜色：\"\" 不填充，填充自动闭合起始点和结束点",
      "type": [
        "string",
        "null"
      ]
    },
    "strokeWidth": {
      "description": "宽度",
      "type": [
        "number",
        "null"
      ]
    },
    "fillStyle": {
      "description": "填充样式, null 为默认",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NONE",
        "SOLID",
        "GRID",
        "HORIZONTAL_LINE",
        "VERTICAL_LINE",
        "RHOMBIC",
        "LEFT_SLASH_LINE",
        "RIGHT_SLASH_LINE"
      ],
      "enumDescriptions": {
        "NONE": "无填充",
        "SOLID": "实心填充",
        "GRID": "网格",
        "HORIZONTAL_LINE": "横线",
        "VERTICAL_LINE": "竖线",
        "RHOMBIC": "菱形网格",
        "LEFT_SLASH_LINE": "左斜线",
        "RIGHT_SLASH_LINE": "右斜线"
      }
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "points",
    "closed",
    "startShape",
    "endShape",
    "strokeColor",
    "strokeStyle",
    "fillColor",
    "strokeWidth",
    "fillStyle"
  ],
  "description": "原理图多边形"
}