{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partId": {
      "description": "部件编号；符号页专属，表示归属于某部件下, 非符号忽略该字段",
      "type": "string"
    },
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex"
  ],
  "description": "基础字段"
}