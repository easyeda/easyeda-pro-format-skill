{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "layerId": {
      "description": "层编号",
      "type": "number"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "startX": {
      "description": "左上 X",
      "type": "number"
    },
    "startY": {
      "description": "左上 Y",
      "type": "number"
    },
    "width": {
      "description": "宽",
      "type": "number"
    },
    "height": {
      "description": "高",
      "type": "number"
    },
    "angle": {
      "description": "旋转角度（角度制），绕 起始 点",
      "type": "number"
    },
    "mirror": {
      "description": "原始图片是否水平镜像，镜像以原始图片 BBox 中点进行水平镜像",
      "type": "boolean"
    },
    "path": {
      "description": "请参考复杂多边形章节，这里存储的是原始数据，整个生命周期不需要调整",
      "type": "array"
    },
    "specialColor": {
      "description": "特殊颜色",
      "type": "string",
      "pattern": "^$|^#[0-9A-Fa-f]{6}$"
    }
  },
  "required": [
    "groupId",
    "layerId",
    "locked",
    "zIndex",
    "startX",
    "startY",
    "width",
    "height",
    "angle",
    "mirror",
    "path"
  ],
  "description": "图片"
}