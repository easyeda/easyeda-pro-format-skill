{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "text": {
      "description": "文字内容",
      "type": "string"
    },
    "fontFamily": {
      "description": "字体名称",
      "type": "string"
    },
    "fontSize": {
      "description": "字号",
      "type": "number"
    },
    "thickness": {
      "description": "粗细",
      "type": "number"
    },
    "bold": {
      "description": "是否加粗",
      "type": "boolean"
    },
    "italic": {
      "description": "是否斜体",
      "type": "boolean"
    },
    "reverse": {
      "description": "是否反相扩展",
      "type": "boolean"
    },
    "expansion": {
      "description": "反相扩展尺寸，支持负数",
      "type": "number"
    }
  },
  "required": [
    "text",
    "fontFamily",
    "fontSize",
    "thickness",
    "bold",
    "italic",
    "reverse",
    "expansion"
  ],
  "description": "字体的基本数据"
}