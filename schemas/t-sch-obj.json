{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partId": {
      "description": "部件编号；符号页专属，表示归属于某部件下, 非符号忽略该字段",
      "type": "string"
    },
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "fileName": {
      "description": "文件名",
      "type": "string"
    },
    "startX": {
      "description": "左上角 X",
      "type": "number"
    },
    "startY": {
      "description": "左上角 Y",
      "type": "number"
    },
    "width": {
      "description": "宽",
      "type": "number",
      "minimum": 0
    },
    "height": {
      "description": "高",
      "type": "number",
      "minimum": 0
    },
    "rotation": {
      "description": "旋转角度（角度制）：绕左上角旋转",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "isMirror": {
      "description": "是否镜像",
      "type": "boolean"
    },
    "content": {
      "description": "二进制数据，有两种模式一般格式，1.遵循 Data Urls 规范 data:[<mediatype>][;base64],<data> 2.BLOB引用模式，blob:hashid",
      "type": "string",
      "pattern": "^(data:)|(blob:)"
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "fileName",
    "startX",
    "startY",
    "width",
    "height",
    "rotation",
    "isMirror",
    "content"
  ],
  "description": "原理图二进制内嵌对象"
}