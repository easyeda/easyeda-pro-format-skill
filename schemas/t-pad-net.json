{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "componentId": {
      "description": "所属器件实例编号",
      "type": "string"
    },
    "padNum": {
      "description": "焊盘编号",
      "type": "string"
    },
    "padNet": {
      "description": "网络名",
      "type": "string"
    },
    "padId": {
      "description": "封装内焊盘 ID（可选）",
      "type": "string"
    },
    "padLen": {
      "description": "引脚长度",
      "type": "number"
    },
    "propagationDelay": {
      "description": "传播延迟，3.3+ 新增：**单位 ps（皮秒）**。\r\n\r\n 表示该焊盘（网络节点）对所属网络总延迟的贡献，与 `padLen` 一起参与等长/时序分析。\r\n 默认 0 表示不额外贡献延迟。",
      "type": "number"
    },
    "attrsMap": {
      "description": "自定义属性",
      "type": "object"
    }
  },
  "required": [
    "componentId",
    "padNum",
    "padNet",
    "padId",
    "padLen",
    "propagationDelay"
  ],
  "description": "焊盘实例网络映射"
}