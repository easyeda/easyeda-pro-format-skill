{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "layerId": {
      "description": "层编号",
      "type": "number"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "netName": {
      "description": "NET，网络名称",
      "type": "string"
    },
    "width": {
      "description": "线宽",
      "type": "number"
    },
    "name": {
      "description": "覆铜名称",
      "type": "string"
    },
    "order": {
      "description": "覆铜优先级",
      "type": "number"
    },
    "path": {
      "description": "请参考复杂多边形章节",
      "type": "array"
    },
    "pourType": {
      "description": "请参考覆铜类型",
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pourType": {
              "description": "实心填充",
              "type": "string",
              "enum": [
                "SOLID"
              ],
              "enumDescriptions": {
                "SOLID": "实心填充"
              }
            },
            "fineness": {
              "description": "最小覆铜细度",
              "type": "number"
            }
          },
          "required": [
            "pourType",
            "fineness"
          ],
          "description": "实心填充"
        },
        {
          "type": "object",
          "properties": {
            "pourType": {
              "description": "线填充",
              "type": "string",
              "enum": [
                "GRID_LINE",
                "HORIZONTAL_LINE",
                "VERTICAL_LINE"
              ],
              "enumDescriptions": {
                "GRID_LINE": "网格线填充",
                "HORIZONTAL_LINE": "水平线填充",
                "VERTICAL_LINE": "垂直线填充"
              }
            },
            "angle": {
              "description": "旋转角度",
              "type": "number"
            },
            "strokeWidth": {
              "description": "线宽",
              "type": "number"
            },
            "strokeSpacing": {
              "description": "线距",
              "type": "number"
            }
          },
          "required": [
            "pourType",
            "angle",
            "strokeWidth",
            "strokeSpacing"
          ],
          "description": "线填充"
        }
      ]
    },
    "keepIsland": {
      "description": "是否保留孤岛",
      "type": "boolean"
    }
  },
  "required": [
    "groupId",
    "layerId",
    "locked",
    "zIndex",
    "netName",
    "width",
    "name",
    "order",
    "path",
    "pourType",
    "keepIsland"
  ],
  "description": "覆铜边框"
}