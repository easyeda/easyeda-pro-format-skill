{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为空（预留）：\"0\" 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string",
      "pattern": "^0$|^[1-9][0-9]*$"
    },
    "layer": {
      "description": "层",
      "type": "number",
      "minimum": 0
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "default": null
    },
    "valid": {
      "description": "是否生效",
      "type": "boolean"
    },
    "visible": {
      "description": "是否可见",
      "type": "boolean"
    },
    "cover": {
      "description": "遮盖透明度",
      "type": [
        "number",
        "null"
      ]
    },
    "name": {
      "description": "名称",
      "type": "string"
    }
  },
  "required": [
    "groupId",
    "layer",
    "locked",
    "zIndex",
    "valid",
    "visible",
    "cover",
    "name"
  ],
  "description": "基础字段"
}