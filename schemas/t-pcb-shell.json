{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "shellType": {
      "description": "外壳类型（取值与含义见 E3DShellOutlineType）",
      "type": "string",
      "enum": [
        "DRAWER",
        "T&B"
      ],
      "enumDescriptions": {
        "DRAWER": "推盖",
        "T&B": "上下壳"
      }
    },
    "shellHeight": {
      "description": "外壳高度",
      "type": "number"
    },
    "pcbHeight": {
      "description": "PCB 高度",
      "type": "number"
    },
    "strokeWidth": {
      "description": "线宽（弃用）",
      "type": "number"
    },
    "path": {
      "description": "参考复杂多边形",
      "type": "array"
    },
    "thickness": {
      "description": "外壳厚度",
      "type": "number"
    },
    "direction": {
      "description": "推盖 - 推盖方向",
      "type": "string",
      "enum": [
        "X_AXIS_POSITIVE",
        "X_AXIS_NEGATIVE",
        "Y_AXIS_POSITIVE",
        "Y_AXIS_NEGATIVE"
      ],
      "enumDescriptions": {
        "X_AXIS_POSITIVE": "X轴正向",
        "X_AXIS_NEGATIVE": "X轴负向",
        "Y_AXIS_POSITIVE": "Y轴正向",
        "Y_AXIS_NEGATIVE": "Y轴负向"
      }
    },
    "bottomHeight": {
      "description": "上下壳 - 下壳高度",
      "type": "number"
    },
    "topInnerHeight": {
      "description": "上下壳 - 上壳内壁高度",
      "type": "number"
    },
    "bottomInnerHeight": {
      "description": "上下壳 - 下壳内壁高度",
      "type": "number"
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "shellType",
    "shellHeight",
    "pcbHeight",
    "strokeWidth",
    "path",
    "thickness"
  ],
  "description": "外壳"
}