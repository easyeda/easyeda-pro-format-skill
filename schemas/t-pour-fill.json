{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "唯一标识",
      "type": "string"
    },
    "strokeWidth": {
      "description": "描边线宽：0 为不描边",
      "type": "number"
    },
    "fill": {
      "description": "是否填充",
      "type": "boolean"
    },
    "path": {
      "description": "路径，复杂多边形",
      "type": "array"
    }
  },
  "required": [
    "id",
    "strokeWidth",
    "fill",
    "path"
  ],
  "description": "覆铜填充结果"
}