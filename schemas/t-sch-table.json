                  "SOLID": "实心填充",
                  "GRID": "网格",
                  "HORIZONTAL_LINE": "横线",
                  "VERTICAL_LINE": "竖线",
                  "RHOMBIC": "菱形网格",
                  "LEFT_SLASH_LINE": "左斜线",
                  "RIGHT_SLASH_LINE": "右斜线"
                },
                "default": null
              }
            },
            "required": [
