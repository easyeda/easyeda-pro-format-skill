{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "partId": {
      "description": "部件编号；符号页专属，表示归属于某部件下, 非符号忽略该字段",
      "type": "string"
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "startX": {
      "description": "左上角 X",
      "type": "number"
    },
    "startY": {
      "description": "左上角 Y",
      "type": "number"
    },
    "rowSizes": {
      "description": "行高",
      "type": "array"
    },
    "colSizes": {
      "description": "列宽",
      "type": "array"
    },
    "rowLocked": {
      "description": "行锁定",
      "type": "array"
    },
    "colLocked": {
      "description": "列锁定",
      "type": "array"
    },
    "rotation": {
      "description": "旋转角度（角度制）",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "tableCell": {
      "description": "表格单元格",
      "type": "array"
    }
  },
  "required": [
    "groupId",
    "zIndex",
    "startX",
    "startY",
    "rowSizes",
    "colSizes",
    "rowLocked",
    "colLocked",
    "rotation",
    "tableCell"
  ],
  "description": "表格"
}