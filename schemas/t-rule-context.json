{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "SAFE": {
      "description": "间距 - 安全间距",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位：仅作显示与精度参考，见 TRuleContext 的【长度单位】说明"
        },
        "isForAll": {
          "description": "安全间距表的显示状态\r\n\r\n取值（`EShowStatus`）：\r\n- `ALL` 全部\r\n- `LAYERED` 分层\r\n\r\n注：2.0 旧数据里该字段是数字（0 全部、1 分层），解析时会被转换。"
        },
        "safeSpacing": {
          "description": "安全间距",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layerId": {
                "description": "层编号"
              },
              "isOpen": {
                "description": "是否展开"
              },
              "content": {
                "description": "具体内容"
              },
              "columnNames": {
                "description": "列名"
              }
            }
          }
        }
      }
    },
    "OTHER": {
      "description": "间距 - 其他间距",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "deviceClearance": {
          "description": "元件到元件"
        },
        "thru2SmdClearance": {
          "description": "多层焊盘（通孔焊盘）与贴片元件的间距"
        },
        "holeClearance": {
          "description": "钻孔到钻孔"
        }
      }
    },
    "CREEPAGE": {
      "description": "间距 - 爬电间距",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "creepageDistance": {
          "description": "爬电间距"
        },
        "ignoreLayer": {
          "description": "是否忽略内层"
        }
      }
    },
    "TRACK": {
      "description": "物理 - 导线",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "track": {
          "description": "导线",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "layerId": {
                    "description": "层编号"
                  },
                  "stroMin": {
                    "description": "线宽 - 最小值"
                  },
                  "stroDef": {
                    "description": "线宽 - 默认值"
                  },
                  "stroMax": {
                    "description": "线宽 - 最大值"
                  }
                }
              }
            }
          }
        }
      }
    },
    "BLIND": {
      "description": "物理 - 盲埋孔",
      "type": "object",
      "properties": {
        "blinds": {
          "description": "盲埋孔",
          "type": "object",
          "properties": {
            "content": {
              "description": "具体内容",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "名称"
                  },
                  "staLayerId": {
                    "description": "起始层"
                  },
                  "endLayerId": {
                    "description": "结束层"
                  },
                  "viaSizeRule": {
                    "description": "所引用的孔径规则名称（字符串，不是数值）"
                  }
                }
              }
            }
          }
        }
      }
    },
    "RADIUS": {
      "description": "物理 - 孔径",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minRadius": {
          "description": "过孔外**半径** - 最小（外直径 = 本值 × 2）"
        },
        "defRadius": {
          "description": "过孔外**半径** - 默认（外直径 = 本值 × 2）"
        },
        "maxRadius": {
          "description": "过孔外**半径** - 最大（外直径 = 本值 × 2）"
        },
        "minInner": {
          "description": "过孔内**半径** - 最小（内直径 = 本值 × 2）"
        },
        "defInner": {
          "description": "过孔内**半径** - 默认（内直径 = 本值 × 2）"
        },
        "maxInner": {
          "description": "过孔内**半径** - 最大（内直径 = 本值 × 2）"
        }
      }
    },
    "PLANE": {
      "description": "平面 - 内电层",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "mulPad": {
          "description": "多层焊盘",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "layerId": {
                    "description": "层编号"
                  },
                  "connType": {
                    "description": "连接方式\r\n\r\n取值（`EPadConnect`）：\r\n- `DIVERGENCE` 热焊（发散）\r\n- `DIRECT` 直连\r\n- `NON_CONNECT` 无连接"
                  },
                  "spoSpac": {
                    "description": "发散间距"
                  },
                  "spoWidth": {
                    "description": "发散线宽"
                  },
                  "spoAng": {
                    "description": "发散角度：单位为**度**（编辑器内部按弧度使用，读取时需换算）"
                  }
                }
              }
            }
          }
        }
      }
    },
    "COPPER": {
      "description": "平面 - 铺铜",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "sglPad": {
          "description": "单层焊盘",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容"
            }
          }
        },
        "mulPad": {
          "description": "多层焊盘",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容"
            }
          }
        },
        "track": {
          "description": "导线",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容"
            }
          }
        }
      }
    },
    "PASTE": {
      "description": "扩展 - 助焊",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "padTopExpan": {
          "description": "焊盘 - 顶层扩展"
        },
        "padBotExpan": {
          "description": "焊盘 - 底层扩展"
        },
        "testPointTopExpan": {
          "description": "测试点 - 顶层扩展\r\n\r\n 注意：允许**负值**，负数哨兵表示「无扩展」（旧数组格式缺省 -1000、\r\n 新对象格式缺省 -100），因此不能用 `>= 0` 校验。"
        },
        "testPointBotExpan": {
          "description": "测试点 - 底层扩展\r\n\r\n 注意：允许**负值**，负数哨兵表示「无扩展」（同 testPointTopExpan）。"
        }
      }
    },
    "SOLDER": {
      "description": "扩展 - 阻焊",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "padTopExpan": {
          "description": "焊盘 - 顶层扩展"
        },
        "padBotExpan": {
          "description": "焊盘 - 底层扩展"
        },
        "viaTopExpan": {
          "description": "过孔 - 顶层扩展\r\n\r\n 注意：允许**负值**，负数表示「负扩展（内缩）」，默认即为负值\r\n （内部 -100、写盘 -1000），不能用 `>= 0` 校验。"
        },
        "viaBotExpan": {
          "description": "过孔 - 底层扩展\r\n\r\n 注意：允许**负值**，负数表示「负扩展（内缩）」（同 viaTopExpan）。"
        },
        "testPointTopExpan": {
          "description": "测试点 - 顶层扩展"
        },
        "testPointBotExpan": {
          "description": "测试点 - 底层扩展"
        }
      }
    },
    "DIFFER_ENTAIL": {
      "description": "物理 - 差分对",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "stroWidth": {
          "description": "线宽",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容"
            }
          }
        },
        "spacing": {
          "description": "间距",
          "type": "object",
          "properties": {
            "isOpen": {
              "description": "是否展开"
            },
            "content": {
              "description": "具体内容"
            }
          }
        },
        "differPairLenTolerMax": {
          "description": "差分对长度误差"
        },
        "toleranceUnit": {
          "description": "差分对长度公差单位（**可缺省**）：通常为长度单位，也可取值时间单位（如 `'ps'`），\r\n 此时公差数值的量纲随之改变。\r\n\r\n ⚠️ 本仓转换腿显式写 `undefined`（经 `JSON.stringify` 被丢弃），真实数据里也没有该字段，\r\n 因此**缺省时量纲随 `unit`**，读取端不得假设该键一定存在。"
        }
      }
    },
    "NET_LENGTH": {
      "description": "物理 - 网络长度范围",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "netLenMin": {
          "description": "网络长度下限 - 最小值：网络长度小于此值即判超下限"
        },
        "netLenMax": {
          "description": "网络长度上限 - 最大值：网络长度大于此值即判超上限"
        }
      }
    },
    "AUTO_ROUTER": {
      "description": "布线 - 自动布线",
      "type": "object",
      "properties": {
        "routingCorner": {
          "description": "布线角度\r\n\r\n取值（`EAutoRoutingCorner`）：\r\n- `L45` 45度\r\n- `L90` 90度拐角\r\n- `A90` 90度圆弧拐角"
        },
        "isKeep": {
          "description": "是否保留已有布线数据：本仓写盘为 0/1 数字，外部转换器写 true/false，\r\n 两种形态并存，读取时按真假处理"
        },
        "viaQuantity": {
          "description": "过孔数量：自动布线允许使用的过孔数量档位\r\n\r\n 取值（`EAutoRoutingViaQuantity`）：\r\n - `LESS` 较少\r\n - `MID` 中等\r\n - `MORE` 较多\r\n\r\n 注：该字段目前只做读写透传，未找到实际消费方"
        },
        "routingEffectPriority": {
          "description": "效果优先级：自动布线的效果优先档位\r\n\r\n 取值（`EAutoRoutingPriority`）：\r\n - `SPEED_FIRST` 速度优先\r\n - `COMPLETION_FIRST` 完成度优先"
        },
        "layers": {
          "description": "布线层"
        },
        "ignoreNets": {
          "description": "忽略的网络"
        }
      }
    },
    "NET_LENGTH_TOLERANCE": {
      "description": "物理 - 网络长度公差",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "netLengthTolerance": {
          "description": "网络长度公差"
        }
      }
    },
    "HEIGHT": {
      "description": "物理 - 最大高度",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "maxHeight": {
          "description": "最大高度"
        }
      }
    },
    "DFM_ACUTE_ANGLE": {
      "description": "制造-线路分析 - 锐角拐线",
      "type": "object",
      "properties": {
        "minAngle": {
          "description": "最小角度\r\n 单位为**度**（编辑器内部按弧度使用，读取时需换算）"
        }
      }
    },
    "DFM_HOLE_FALLS_ON_PAD": {
      "description": "制造-线路分析 - 孔落在焊盘上",
      "type": "object"
    },
    "DFM_BARE_TRACK_ENDS": {
      "description": "制造-线路分析 - 裸线头",
      "type": "object"
    },
    "DFM_PAD_RING_DEFECT": {
      "description": "制造-线路分析 - 焊盘孔环",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minRingWidth": {
          "description": "最小环宽：焊盘孔环（孔壁到焊盘边缘）允许的最小宽度"
        }
      }
    },
    "DFM_TRACK_NECKDOWN": {
      "description": "制造-线路分析 - 导线颈部收缩",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minNeckWidth": {
          "description": "最小颈部宽度"
        }
      }
    },
    "DFM_SHORT_CIRCUIT_DETECT": {
      "description": "制造-线路分析 - 短路提示",
      "type": "object"
    },
    "DFM_MIN_COPPER_WIDTH": {
      "description": "制造-线路分析 - 最小铜箔宽度",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minCopperWidth": {
          "description": "最小铜箔宽度"
        }
      }
    },
    "DFM_DISCONNECTED_VIAS": {
      "description": "制造-钻孔分析 - 无连接过孔",
      "type": "object"
    },
    "DFM_MIN_HOLE_SIZE": {
      "description": "制造-钻孔分析 - 孔尺寸",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minHoleSize": {
          "description": "最小孔径尺寸"
        }
      }
    },
    "DFM_NPTH_2_COPPER": {
      "description": "制造-钻孔分析 - NPTH孔到铜箔",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minClearance": {
          "description": "最小安全间距"
        }
      }
    },
    "DFM_SOLDER_MASK_BRIDGE": {
      "description": "制造-阻焊分析 - 阻焊桥",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minClearance": {
          "description": "阻焊桥最小距离"
        }
      }
    },
    "DFM_SMASK_OPENING_COPPER": {
      "description": "制造-阻焊分析 - 开窗露线",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minClearance": {
          "description": "阻焊开窗到周边走线的最小间距：小于此值会导致周边走线裸露，易氧化或焊接短路"
        }
      }
    },
    "DFM_PAD_NEGATIVE_OPENING": {
      "description": "制造-阻焊分析 - 焊盘负开窗",
      "type": "object"
    },
    "DFM_SILKSCREEN_2_HOLE": {
      "description": "制造-丝印分析 - 丝印距孔",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minClearance": {
          "description": "丝印距孔最小距离"
        }
      }
    },
    "DFM_SILKSCREEN_2_PAD": {
      "description": "制造-丝印分析 - 丝印距焊盘",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minClearance": {
          "description": "丝印距焊盘最小距离"
        }
      }
    },
    "DFM_SILKSCREEN_LINE_WIDTH": {
      "description": "制造-丝印分析 - 丝印线条宽度",
      "type": "object",
      "properties": {
        "unit": {
          "description": "单位"
        },
        "minLineWidth": {
          "description": "丝印线条最小宽度"
        }
      }
    }
  },
  "required": [
    "SAFE",
    "OTHER",
    "CREEPAGE",
    "TRACK",
    "BLIND",
    "RADIUS",
    "PLANE",
    "COPPER",
    "PASTE",
    "SOLDER",
    "DIFFER_ENTAIL",
    "NET_LENGTH",
    "AUTO_ROUTER",
    "NET_LENGTH_TOLERANCE",
    "HEIGHT",
    "DFM_ACUTE_ANGLE",
    "DFM_HOLE_FALLS_ON_PAD",
    "DFM_BARE_TRACK_ENDS",
    "DFM_PAD_RING_DEFECT",
    "DFM_TRACK_NECKDOWN",
    "DFM_SHORT_CIRCUIT_DETECT",
    "DFM_MIN_COPPER_WIDTH",
    "DFM_DISCONNECTED_VIAS",
    "DFM_MIN_HOLE_SIZE",
    "DFM_NPTH_2_COPPER",
    "DFM_SOLDER_MASK_BRIDGE",
    "DFM_SMASK_OPENING_COPPER",
    "DFM_PAD_NEGATIVE_OPENING",
    "DFM_SILKSCREEN_2_HOLE",
    "DFM_SILKSCREEN_2_PAD",
    "DFM_SILKSCREEN_LINE_WIDTH"
  ],
  "description": "设计规则内容\r\n\r\n【结构】这是一个**扁平对象**：键直接是各规则的字段名（`unit`、`isForAll`、`safeSpacing`…），\r\n而不是按规则类型再分一层的嵌套结构。\r\n\r\n【长度单位】除下述例外，本类型内所有长度类数值一律以 **mil** 为口径，与 `unit` 字段的取值无关。\r\n`unit` 只作显示与精度（小数位）参考，不参与数值换算；解析端如需 mm 请自行换算\r\n（1 mil = 0.0254 mm）。\r\n\r\n【例外】可携带**时间量纲**的只有这三处：\r\n- `NET_LENGTH` / `NET_LENGTH_TOLERANCE`：由自身的 `unit` 承载，当 `unit` 是时间单位\r\n  （如 `'ps'`）时，数值表示的是**传输延迟**而非几何长度；\r\n- `DIFFER_ENTAIL`：由独立的 `toleranceUnit` 承载（**该字段可缺省**，缺省时量纲随 `unit`），\r\n  `unit` 仍表示长度单位。"
}