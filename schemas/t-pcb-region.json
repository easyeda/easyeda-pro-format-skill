{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "layerId": {
      "description": "层编号",
      "type": "number"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "width": {
      "description": "线宽",
      "type": "number"
    },
    "prohibitType": {
      "description": "禁止类型，可同时存在多个（取值与含义见 EProhibitType）\r\n\r\n旧格式遗留的编号（不是当前取值，解析时需兼容）：\r\n1 布线与放置填充区域、2 元件、3 过孔、4 覆铜与内电层、\r\n5 布线、6 放置填充区域、7 覆铜、8 内电层",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "COMPONENT",
          "VIA",
          "TRACK",
          "FILL",
          "COPPER",
          "PLANE"
        ],
        "enumDescriptions": {
          "COMPONENT": "禁止元件",
          "VIA": "禁止过孔",
          "TRACK": "禁止布线",
          "FILL": "禁止放置填充区域",
          "COPPER": "禁止覆铜",
          "PLANE": "禁止内电层"
        }
      }
    },
    "path": {
      "description": "请参考复杂多边形章节",
      "type": "array"
    },
    "name": {
      "description": "名称（可选）",
      "type": "string"
    },
    "regionType": {
      "description": "区域类型：0 禁止区域，1 约束区域",
      "type": "string",
      "enum": [
        "PROHIBIT",
        "CONSTRAINT"
      ],
      "enumDescriptions": {
        "PROHIBIT": "禁止区域",
        "CONSTRAINT": "约束区域"
      }
    }
  },
  "required": [
    "groupId",
    "layerId",
    "locked",
    "zIndex",
    "width",
    "prohibitType",
    "path",
    "name",
    "regionType"
  ],
  "description": "区域"
}