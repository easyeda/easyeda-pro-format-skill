{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "uuid": {
      "description": "唯一编号",
      "type": "string"
    },
    "title": {
      "description": "名称",
      "type": "string"
    },
    "description": {
      "description": "描述",
      "type": "string"
    },
    "schematicId": {
      "description": "原理图",
      "type": "string"
    },
    "zIndex": {
      "description": "排序",
      "type": "number"
    },
    "notGrouped": {
      "description": "是否有未归组",
      "type": "boolean"
    },
    "isDelete": {
      "description": "是否删除",
      "type": "boolean"
    }
  },
  "required": [
    "uuid",
    "title",
    "description",
    "schematicId",
    "zIndex",
    "notGrouped"
  ],
  "description": "变体结构"
}