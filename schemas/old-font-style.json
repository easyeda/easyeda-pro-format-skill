{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "color": {
      "description": "颜色",
      "type": [
        "string",
        "null"
      ]
    },
    "fillColor": {
      "description": "背景色",
      "type": [
        "string",
        "null"
      ]
    },
    "fontFamily": {
      "description": "字体名称",
      "type": [
        "string",
        "null"
      ]
    },
