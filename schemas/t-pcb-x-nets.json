{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "xNetsGroup": {
      "description": "所属 xNet 组的组名：必须指向一个已存在的 X_NET_GROUP\r\n\r\n 【联动增删·必须成组操作】X_NET 不能脱离组存在——\r\n **新增 X_NET 时必须确保其所属的 X_NET_GROUP 已写出；\r\n 删除 X_NET_GROUP 时必须把组内所有 X_NET 一并删除**（见 X_NET_GROUP 的说明）。",
      "type": "string"
    },
    "name": {
      "description": "xNet名称",
      "type": "string"
    },
    "netLengthPhysic": {
      "description": "网络长度规则  --- 对应具体xNet规则的",
      "type": "string"
    },
    "netLengthTolerancePhysics": {
      "description": "网络长度公差规则  --- 对应具体xNet规则的",
      "type": "string"
    },
    "targetNet": {
      "description": "目标网络",
      "type": "string"
    },
    "length": {
      "description": "xNet 路径长度",
      "type": "number"
    },
    "xNet": {
      "description": "xNet的连通路径",
      "type": "object",
      "properties": {
        "start": {
          "description": "起点"
        },
        "end": {
          "description": "终点"
        },
        "nodes": {
          "description": "所有联通节点顺序<焊盘、过孔、器件>"
        }
      }
    }
  },
  "required": [
    "xNetsGroup",
    "name",
    "netLengthPhysic",
    "netLengthTolerancePhysics",
    "targetNet",
    "length",
    "xNet"
  ],
  "description": "组内的 xNet"
}