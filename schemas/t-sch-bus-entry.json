{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "order": {
      "description": "顺序编号：在隶属的 BUS 里的顺序编号，可重复",
      "type": "number",
      "minimum": 0
    },
    "pointX": {
      "description": "端点 X",
      "type": "number"
    },
    "pointY": {
      "description": "端点 Y",
      "type": "number"
    },
    "rotation": {
      "description": "旋转角度（角度制）：绕 端点 旋转",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "order",
    "pointX",
    "pointY",
    "rotation"
  ],
  "description": "总线接入标识"
}