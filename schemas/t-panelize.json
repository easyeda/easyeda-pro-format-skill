{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "on": {
      "description": "是否启用",
      "type": "boolean"
    },
    "row": {
      "description": "行数",
      "type": "number"
    },
    "column": {
      "description": "列数",
      "type": "number"
    },
    "rowSpacing": {
      "description": "行距",
      "type": "number"
    },
    "columnSpacing": {
      "description": "列距",
      "type": "number"
    },
    "onlyOutline": {
      "description": "是否只拼边框",
      "type": "boolean"
    },
    "horizontalStamp": {
      "description": "邮票孔参数 - 水平",
      "type": "object",
      "properties": {
        "on": {
          "description": "是否启用（不启用则使用 V-CUT）",
          "type": "boolean"
        },
        "stampHoleGroupQuantity": {
          "description": "邮票孔组数",
          "type": "number"
        },
        "stampHoleDiameter": {
          "description": "邮票孔直径",
          "type": "number"
        },
        "stampHoleQuantityPerGroup": {
          "description": "邮票孔每组数量",
          "type": "number"
        },
        "stampHoleSpacing": {
          "description": "邮票孔间距",
          "type": "number"
        },
        "center_percent": {
          "description": "邮票孔组位置与板子左侧的距离——**比例值（0~1 的小数，不是百分数）**，\r\n 实际坐标 = 板框左边界 + 比例 × 板框宽度；数组元素对应各组。\r\n 例：`[0.3333, 0.6667]` 表示两组分别位于板宽 1/3、2/3 处。\r\n 不填时按组序均分：第 i 组取 `(i+1)/(组数+1)`。",
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "on",
        "stampHoleGroupQuantity",
        "stampHoleDiameter",
        "stampHoleQuantityPerGroup",
        "stampHoleSpacing"
      ]
    },
    "verticalStamp": {
      "description": "邮票孔参数 - 垂直",
      "type": "object",
      "properties": {
        "on": {
          "description": "是否启用（不启用则使用 V-CUT）",
          "type": "boolean"
        },
        "stampHoleGroupQuantity": {
          "description": "邮票孔组数",
          "type": "number"
        },
        "stampHoleDiameter": {
          "description": "邮票孔直径",
          "type": "number"
        },
        "stampHoleQuantityPerGroup": {
          "description": "邮票孔每组数量",
          "type": "number"
        },
        "stampHoleSpacing": {
          "description": "邮票孔间距",
          "type": "number"
        },
        "center_percent": {
          "description": "邮票孔组位置与板子左侧的距离——**比例值（0~1 的小数，不是百分数）**，\r\n 实际坐标 = 板框左边界 + 比例 × 板框宽度；数组元素对应各组。\r\n 例：`[0.3333, 0.6667]` 表示两组分别位于板宽 1/3、2/3 处。\r\n 不填时按组序均分：第 i 组取 `(i+1)/(组数+1)`。",
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "on",
        "stampHoleGroupQuantity",
        "stampHoleDiameter",
        "stampHoleQuantityPerGroup",
        "stampHoleSpacing"
      ]
    },
    "horizontalSize": {
      "description": "工艺边参数 - 水平（方向由本字段位置表达；解码端会注入 `direction: 0`，\r\n 但**真实样本里没有该键**、读盘别依赖它——详见 TPanelizeSide 的说明）",
      "type": "object",
      "properties": {
        "on": {
          "description": "是否启用（不启用则不使用工艺边）",
          "type": "boolean"
        },
        "sideHeight": {
          "description": "工艺边高度",
          "type": "number"
        },
        "positionHoleDiameter": {
          "description": "定位孔直径（0 表示无定位孔）",
          "type": "number"
        },
        "markDiameter": {
          "description": "Mark 点直径（0 表示不启用 Mark 点）",
          "type": "number"
        },
        "markExpansion": {
          "description": "Mark 点阻焊扩展",
          "type": "number"
        },
        "borderRadius": {
          "description": "工艺边圆角半径",
          "type": "number"
        }
      },
      "required": [
        "on",
        "sideHeight",
        "positionHoleDiameter",
        "markDiameter",
        "markExpansion",
        "borderRadius"
      ]
    },
    "verticalSize": {
      "description": "工艺边参数 - 垂直（方向由本字段位置表达；解码端会注入 `direction: 1`，\r\n 但**真实样本里没有该键**、读盘别依赖它——详见 TPanelizeSide 的说明）",
      "type": "object",
      "properties": {
        "on": {
          "description": "是否启用（不启用则不使用工艺边）",
          "type": "boolean"
        },
        "sideHeight": {
          "description": "工艺边高度",
          "type": "number"
        },
        "positionHoleDiameter": {
          "description": "定位孔直径（0 表示无定位孔）",
          "type": "number"
        },
        "markDiameter": {
          "description": "Mark 点直径（0 表示不启用 Mark 点）",
          "type": "number"
        },
        "markExpansion": {
          "description": "Mark 点阻焊扩展",
          "type": "number"
        },
        "borderRadius": {
          "description": "工艺边圆角半径",
          "type": "number"
        }
      },
      "required": [
        "on",
        "sideHeight",
        "positionHoleDiameter",
        "markDiameter",
        "markExpansion",
        "borderRadius"
      ]
    },
    "mirrorBoard": {
      "description": "阴阳板",
      "type": "boolean"
    },
    "mirrorEvenRow": {
      "description": "偶数行翻面",
      "type": "boolean"
    },
    "mirrorEvenCol": {
      "description": "偶数列翻面",
      "type": "boolean"
    },
    "evenRowRotation": {
      "description": "偶数行角度",
      "type": "number"
    },
    "evenColRotation": {
      "description": "偶数列角度",
      "type": "number"
    },
    "showVCutIndicator": {
      "description": "v割标识",
      "type": "boolean"
    },
    "vCutLayer": {
      "description": "层",
      "type": "number"
    },
    "markPosition": {
      "description": "mark 点位置：**最多 4 个**（按 左上、右上、左下、右下 的顺序存放）。\r\n\r\n 每个元素是 **4 个数**，依次表示该 mark 点中心到最外侧 bbox 的\r\n **`[到上边, 到右边, 到下边, 到左边]`** 四个距离。",
      "type": "array",
      "items": {
        "type": "array"
      }
    },
    "positionHolePosition": {
      "description": "定位孔位置：结构同 `markPosition`（最多 4 个，每个 4 个数 =\r\n `[到上边, 到右边, 到下边, 到左边]` 四个距离），只是承载的是定位孔而非 mark 点。",
      "type": "array",
      "items": {
        "type": "array"
      }
    },
    "panelizeVersion": {
      "description": "拼板版本，默认字段 EPanelizeVersion.pro （新产生的都是最新版本）; 主要作用是要区分不同时期的拼板交互效果和输出的gerber差异。\r\n\r\n 取值：`1.0` 拼板版本 1.0（成员 `pro1`）、`1.1` 拼板版本 1.1（成员 `pro2`）、\r\n `1.1` 拼板版本 1.1（成员 `pro`，当前默认值，与 `pro2` 同值，两个成员是有意保留的别名）。",
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ],
      "enumDescriptions": {
        "1.0": "拼板版本 1.0",
        "1.1": "拼板版本 1.1；拼板版本 1.1（当前默认值，与 pro2 同值，两个成员是有意保留的别名）"
      }
    }
  },
  "required": [
    "on",
    "row",
    "column",
    "rowSpacing",
    "columnSpacing",
    "onlyOutline",
    "horizontalStamp",
    "verticalStamp",
    "horizontalSize",
    "verticalSize",
    "mirrorBoard",
    "mirrorEvenRow",
    "mirrorEvenCol",
    "evenRowRotation",
    "evenColRotation",
    "showVCutIndicator",
    "vCutLayer",
    "panelizeVersion"
  ],
  "description": "拼板"
}