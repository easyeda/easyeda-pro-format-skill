          ],
          "enumDescriptions": {
            "SOLID": "实线",
            "SHORT_DASH": "短划线",
            "DOT": "点线",
            "DOT_DASH": "点划线"
          }
        },
        "fillColor": {
          "description": "填充颜色：\"\" 不填充，填充自动闭合起始点和结束点",
          "type": [
