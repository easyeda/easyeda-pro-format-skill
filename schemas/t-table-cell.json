          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NONE",
            "SOLID",
            "GRID",
            "HORIZONTAL_LINE",
            "VERTICAL_LINE",
            "RHOMBIC",
            "LEFT_SLASH_LINE",
            "RIGHT_SLASH_LINE"
          ],
          "enumDescriptions": {
            "NONE": "无填充",
            "SOLID": "实心填充",
            "GRID": "网格",
            "HORIZONTAL_LINE": "横线",
            "VERTICAL_LINE": "竖线",
            "RHOMBIC": "菱形网格",
