          "description": "填充颜色：\"\" 不填充，填充自动闭合起始点和结束点",
          "type": [
            "string",
            "null"
          ]
        },
        "strokeWidth": {
          "description": "宽度",
          "type": [
            "number",
            "null"
          ]
        },
        "fillStyle": {
          "description": "填充样式, null 为默认",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NONE",
            "SOLID",
            "GRID",
            "HORIZONTAL_LINE",
            "VERTICAL_LINE",
            "RHOMBIC",
            "LEFT_SLASH_LINE",
            "RIGHT_SLASH_LINE"
          ],
          "enumDescriptions": {
            "NONE": "无填充",
            "SOLID": "实心填充",
            "GRID": "网格",
            "HORIZONTAL_LINE": "横线",
            "VERTICAL_LINE": "竖线",
            "RHOMBIC": "菱形网格",
            "LEFT_SLASH_LINE": "左斜线",
            "RIGHT_SLASH_LINE": "右斜线"
          }
        }
      },
      "required": [
        "strokeColor",
        "strokeStyle",
        "fillColor",
