        "strokeStyle",
        "fillColor",
        "strokeWidth",
        "fillStyle"
      ]
    },
    "fontStyle": {
      "description": "表格字体样式",
      "type": "object",
      "properties": {
        "color": {
          "description": "颜色",
          "type": [
            "string",
            "null"
          ]
        },
        "fillColor": {
          "description": "背景色",
          "type": [
            "string",
            "null"
          ]
        },
        "fontFamily": {
          "description": "字体名称",
          "type": [
            "string",
            "null"
          ]
        },
        "fontSize": {
          "description": "字体大小，与坐标等单位相同",
          "type": [
            "number",
            "null"
          ]
        },
        "strikeout": {
          "description": "是否加删除线",
          "type": [
            "boolean",
            "null"
          ]
        },
        "underline": {
          "description": "是否加下划线",
          "type": [
            "boolean",
            "null"
          ]
        },
        "italic": {
          "description": "是否斜体",
          "type": [
            "boolean",
            "null"
          ]
        },
        "fontWeight": {
          "description": "是否加粗",
          "type": [
            "boolean",
            "null"
          ]
        },
        "hAlign": {
          "description": "水平对齐模式",
          "type": "string",
          "enum": [
            "LEFT",
            "CENTER",
            "RIGHT"
          ],
          "enumDescriptions": {
            "LEFT": "左",
            "CENTER": "中",
            "RIGHT": "右"
          }
        },
        "vAlign": {
          "description": "垂直对齐模式",
          "type": "string",
          "enum": [
            "TOP",
            "MIDDLE",
            "BOTTOM"
          ],
          "enumDescriptions": {
            "TOP": "上",
            "MIDDLE": "中",
            "BOTTOM": "下"
          }
        }
      },
      "required": [
        "color",
        "fillColor",
        "fontFamily",
        "fontSize",
        "strikeout",
        "underline",
        "italic",
        "fontWeight",
        "hAlign",
        "vAlign"
      ]
    },
    "lineHeight": {
      "description": "行间距",
      "type": "number",
      "minimum": 0
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    }
