{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "description": "唯一编号",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "value": {
      "description": "内容",
      "type": "string"
    },
    "rowIndex": {
      "description": "行",
      "type": "number",
      "minimum": 0
    },
    "columnIndex": {
      "description": "列",
      "type": "number",
      "minimum": 0
    },
    "rowSpan": {
      "description": "跨行数：本单元格纵向占多少行（其高度 = 连续 rowSpan 行的高度之和）",
      "type": "number",
      "minimum": 1
    },
    "colSpan": {
      "description": "跨列数：本单元格横向占多少列（其宽度 = 连续 colSpan 列的宽度之和）",
      "type": "number",
      "minimum": 1
    },
    "topStyle": {
      "description": "边框线形样式（上）",
      "type": "object",
      "properties": {
        "strokeColor": {
          "description": "描边颜色：`\"#RRGGBB\"` 十六进制色值；**null 表示采用主题默认色**\r\n\r\n 注：本文件各示例中的该字段**一律为 null**，非空色的具体串格式未在示例中出现；\r\n 可参照同文件 `TSchPin.color` 的 `@pattern ^$|^#[0-9A-Fa-f]{6}$`。",
          "type": [
            "string",
            "null"
          ]
        },
        "strokeStyle": {
          "description": "样式, null 为默认\r\n\r\n 取值：`SOLID` 实线、`SHORT_DASH` 短划线、`DOT` 点线、`DOT_DASH` 点划线。",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SOLID",
            "SHORT_DASH",
            "DOT",
            "DOT_DASH",
            null
          ],
          "enumDescriptions": {
            "SOLID": "实线",
            "SHORT_DASH": "短划线",
            "DOT": "点线",
            "DOT_DASH": "点划线"
          },
          "default": null
        },
        "fillColor": {
          "description": "填充颜色：`\"#RRGGBB\"` 十六进制色值；`\"\"` 表示不填充（填充会自动闭合起始点与结束点）；\r\n null 表示采用主题默认",
          "type": [
            "string",
            "null"
          ]
        },
        "strokeWidth": {
          "description": "宽度：null 表示采用主题默认线宽",
          "type": [
            "number",
            "null"
