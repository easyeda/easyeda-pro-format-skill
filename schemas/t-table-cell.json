  "required": [
    "id",
    "value",
    "rowIndex",
    "columnIndex",
    "rowSpan",
    "colSpan",
    "topStyle",
    "rightStyle",
    "bottomStyle",
    "leftStyle",
    "fontStyle",
    "lineHeight",
    "zIndex"
  ],
  "description": "表格单元格"
