{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partitionId": {
      "description": "所属分区编号，为null表示无分区",
      "type": [
        "string",
        "null"
      ]
    },
    "groupId": {
      "description": "分组编号, 没有则为 0 不分组，非 0 为组标志，相同组标志的为一组",
      "type": "string"
    },
    "layerId": {
      "description": "层编号",
      "type": "number"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度, null 为默认",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "netName": {
      "description": "NET，网络名称",
      "type": "string"
    },
    "startX": {
      "description": "开始 X",
      "type": "number"
    },
    "startY": {
      "description": "开始 Y",
      "type": "number"
    },
    "endX": {
      "description": "结束 X",
      "type": "number"
    },
    "endY": {
      "description": "结束 Y",
      "type": "number"
    },
    "width": {
      "description": "线宽",
      "type": "number"
    }
  },
  "required": [
    "groupId",
    "layerId",
    "locked",
    "zIndex",
    "netName",
    "startX",
    "startY",
    "endX",
    "endY",
    "width"
  ],
  "description": "直线"
}