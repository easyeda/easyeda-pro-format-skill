{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ruleSelect": {
      "description": "选择器",
      "type": [
        "object",
        "number",
        "array"
      ]
    },
    "ruleOrder": {
      "description": "优先级：数值越小，优先级越高",
      "type": "number",
      "minimum": 0
    },
    "ruleKeyValue": {
      "description": "规则，Key 为 规则类，Value 为 规则名称，每个规则类下只能选择一个规则",
      "type": "object"
    },
    "copperValue": {
      "description": "铺铜规则(选择值)",
      "type": "object"
    },
    "innerPlaneValue": {
      "description": "内电层规则(选择值)",
      "type": "object"
    },
    "parent": {
      "description": "父选择器",
      "type": [
        "object",
        "number",
        "array"
      ]
    }
  },
  "required": [
    "ruleSelect",
    "ruleOrder",
    "ruleKeyValue",
    "copperValue",
    "innerPlaneValue"
  ],
  "description": "规则选择器"
}