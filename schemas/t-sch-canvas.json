{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "originX": {
      "description": "画布原点 X",
      "type": "number"
    },
    "originY": {
      "description": "画布原点 Y",
      "type": "number"
    },
    "yAxisDirection": {
      "description": "Y 轴方向标记：仅 eprj3 本地文件格式会带，读盘时被剥离；语义见 TYAxisDirection",
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    }
  },
  "required": [
    "originX",
    "originY"
  ],
  "description": "画布配置信息"
}