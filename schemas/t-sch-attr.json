{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "partId": {
      "description": "部件编号；符号页专属，表示归属于某部件下, 非符号忽略该字段",
      "type": "string"
    },
    "groupId": {
      "description": "分组编号, 没有则为空",
      "type": "string"
    },
    "locked": {
      "description": "是否锁定",
      "type": "boolean"
    },
    "zIndex": {
      "description": "Z 轴高度",
      "type": [
        "number",
        "null"
      ]
    },
    "parentId": {
      "description": "隶属编号：隶属于哪个图元，\"\" 表示属于当前块 默认块是文件",
      "type": "string"
    },
    "key": {
      "description": "属性 Key",
      "type": "string"
    },
    "value": {
      "description": "属性 Value",
      "type": "string"
    },
    "keyVisible": {
      "description": "是否显示 Key",
      "type": "boolean"
    },
    "valueVisible": {
      "description": "是否显示 Value",
      "type": "boolean"
    },
    "x": {
      "description": "位置 X：未显示过的属性位置固定为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "y": {
      "description": "位置 Y：未显示过的属性位置固定为 null",
      "type": [
        "number",
        "null"
      ]
    },
    "rotation": {
      "description": "旋转角度（角度制），绕 位置 旋转",
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "version": {
      "description": "表示来自 2.0 版本",
      "type": "object"
    },
    "color": {
      "description": "颜色",
      "type": [
        "string",
        "null"
      ]
    },
    "fillColor": {
      "description": "背景色",
      "type": [
        "string",
        "null"
      ]
    },
    "fontFamily": {
      "description": "字体名称",
      "type": [
        "string",
        "null"
      ]
    },
    "fontSize": {
      "description": "字体大小，与坐标等单位相同",
      "type": [
        "number",
        "null"
      ]
    },
    "strikeout": {
      "description": "是否加删除线",
      "type": [
        "boolean",
        "null"
      ]
    },
    "underline": {
      "description": "是否加下划线",
      "type": [
        "boolean",
        "null"
      ]
    },
    "italic": {
      "description": "是否斜体",
      "type": [
        "boolean",
        "null"
      ]
    },
    "fontWeight": {
      "description": "是否加粗",
      "type": [
        "boolean",
        "null"
      ]
    },
    "align": {
      "description": "对齐模式",
      "type": "string",
      "enum": [
        "LEFT_BOTTOM",
        "CENTER_BOTTOM",
        "RIGHT_BOTTOM",
        "LEFT_MIDDLE",
        "CENTER_MIDDLE",
        "RIGHT_MIDDLE",
        "LEFT_TOP",
        "CENTER_TOP",
        "RIGHT_TOP"
      ],
      "enumDescriptions": {
        "LEFT_BOTTOM": "左底",
        "CENTER_BOTTOM": "中底",
        "RIGHT_BOTTOM": "右底",
        "LEFT_MIDDLE": "左中",
        "CENTER_MIDDLE": "中中",
        "RIGHT_MIDDLE": "右中",
        "LEFT_TOP": "左顶",
        "CENTER_TOP": "中顶",
        "RIGHT_TOP": "右顶"
      }
    }
  },
  "required": [
    "groupId",
    "locked",
    "zIndex",
    "parentId",
    "key",
    "value",
    "keyVisible",
    "valueVisible",
    "x",
    "y",
    "rotation",
    "color",
    "fillColor",
    "fontFamily",
    "fontSize",
    "strikeout",
    "underline",
    "italic",
    "fontWeight",
    "align"
  ],
  "description": "原理图属性"
}